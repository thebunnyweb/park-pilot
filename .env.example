# ---- Database (libSQL / Turso) ----
# Local dev: a plain SQLite file. No account, no server needed.
DATABASE_URL="file:./dev.db"

# Production: a hosted Turso database (see README > Deploying).
# DATABASE_URL="libsql://<your-db>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso db token>"

# ---- Auth (required) ----
# Generate: openssl rand -base64 32
# Also used to encrypt per-user API keys at rest — changing it invalidates stored keys.
AUTH_SECRET="replace-with-a-long-random-string"

# ---- AI planner (optional) ----
# Each user adds their own Anthropic key in Settings (verified, encrypted, stored per-account).
# Setting one here is only a shared fallback for a single-tenant self-host.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
